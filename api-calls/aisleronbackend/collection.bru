headers {
  apikey: {{apiKey}}
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  restUrl: {{baseUrl}}/rest/v1
  authUrl: {{baseUrl}}/auth/v1/token
  rpcUrl: {{restUrl}}/rpc
}

script:pre-request {
  const axios = require("axios");
  
  // Only fetch a new token if we don't have one or it's expired
  if (!bru.getEnvVar("accessToken")) {
    const authUrl = bru.getCollectionVar("authUrl"); 
    const email = bru.getEnvVar("email");
    const password = bru.getEnvVar("password")
    const apiKey = bru.getEnvVar("apiKey")
    
    const resp = await axios.post(`${authUrl}?grant_type=password`, {
      email: email,
      password: password
    }, {
      headers: { 
        "apikey": apiKey,
        "Content-Type": "application/json"
      }
    });
  
    // Save it for this session
    bru.setEnvVar("accessToken", resp.data.access_token);
  }
}
